func _scatter_foliage(vertices: PackedVector3Array) -> void:
	var rng = RandomNumberGenerator.new()
	rng.seed = island_seed
	
	# 1. CLEANUP: Remove old foliage from the last time you pressed Generate
	for child in get_children():
		if child.name.ends_with("_Container") or child.name.ends_with("_MultiMesh"):
			child.free()
			
	for foliage in foliage_types:
		if not foliage: continue
		
		# 2. LOOT CHECK: Does the foliage name contain "-loot"?
		var is_loot = false
		if "-loot" in foliage.name.to_lower():
			is_loot = true
			
		# If it's NOT loot, and it has a mesh, we use optimized multimesh!
		var is_multimesh = not is_loot and foliage.placeholder_mesh != null
		
		# 3. Setup the Container
		var container
		if is_multimesh:
			container = MultiMeshInstance3D.new()
			container.name = foliage.name + "_MultiMesh"
			var mm = MultiMesh.new()
			mm.transform_format = MultiMesh.TRANSFORM_3D
			mm.mesh = foliage.placeholder_mesh
			container.multimesh = mm
			add_child(container)
		else:
			container = Node3D.new()
			container.name = foliage.name + "_Container"
			add_child(container)
			
		# CRITICAL FIX 1: Set the container's owner so Godot saves it!
		if Engine.is_editor_hint() and get_tree() and get_tree().edited_scene_root:
			container.owner = get_tree().edited_scene_root
			
		var spawned_positions = []
		var transform_list = []
		
		# Loop through terrain vertices
		for v in vertices:
			# Only check vertices above water
			if v.y < 0.0: continue 
			
			var is_sand = v.y <= sand_level
			
			# Check sand rules
			if is_sand and not foliage.can_spawn_at_sand: continue
			if not is_sand and foliage.spawn_at_sand_only: continue
			
			# Density check
			if rng.randf() > foliage.density: continue
			
			# Min Distance check
			var too_close = false
			for sp in spawned_positions:
				if sp.distance_to(v) < foliage.min_distance:
					too_close = true
					break
			if too_close: continue
			
			# We passed all rules! Spawn it.
			spawned_positions.append(v)
			
			# Randomize size and rotation
			var scale_val = rng.randf_range(foliage.min_scale, foliage.max_scale)
			var rot_y = rng.randf_range(0, TAU)
			
			var t = Transform3D()
			t = t.scaled(Vector3(scale_val, scale_val, scale_val))
			t = t.rotated(Vector3.UP, rot_y)
			t.origin = v
			
			if is_multimesh:
				transform_list.append(t)
			elif foliage.scene_prefab:
				var instance = foliage.scene_prefab.instantiate()
				instance.transform = t
				container.add_child(instance)
				
				# CRITICAL FIX 2: Set the instance owner so the specific loot object saves!
				if Engine.is_editor_hint() and get_tree() and get_tree().edited_scene_root:
					instance.owner = get_tree().edited_scene_root
					
		# Finalize MultiMesh if we used it
		if is_multimesh:
			container.multimesh.instance_count = transform_list.size()
			for i in transform_list.size():
				container.multimesh.set_instance_transform(i, transform_list[i])


func respawn_foliage() -> void:
	# Ensure the mesh actually exists before trying to extract data from it
	if terrain_mesh_node and terrain_mesh_node.mesh:
		# Extract the mesh arrays from the active surface (0)
		var arrays = terrain_mesh_node.mesh.surface_get_arrays(0)
		
		# Grab the exact vertex coordinates that were calculated when the island was first born
		var vertices = arrays[Mesh.ARRAY_VERTEX]
		
		# Re-run your existing scatter logic! 
		# Your cleanup loop will instantly delete any remaining half-mined rocks, 
		# and place fresh ones using the exact same RNG seed.
		_scatter_foliage(vertices)
