#@tool
extends Node3D
class_name IslandGenerator

const ISLAND_TERRAIN_SHADERS = preload("res://procedural island/config/island_terrain.tres")


@export_group("Map Controls")
@export var generate: bool = false:
	set(value):
		if value:
			island_seed = randi()
			_generate_island()
			generate = false

@export_group("Island Settings")
@export var island_size: float = 100.0
@export var max_height: float = 50.0
@export var sand_level: float = 2.0
@export var island_seed: int = 0
@export var noise: FastNoiseLite
@export var subdivision : Vector2 = Vector2(100, 100)

@export_group("Foliage")
@export var foliage_types: Array[FoliageSetting]

var terrain_mesh_node

enum TerrainNoiseType {
	CELLULAR = FastNoiseLite.TYPE_CELLULAR,
	PERLIN = FastNoiseLite.TYPE_PERLIN,
	SIMPLEX = FastNoiseLite.TYPE_SIMPLEX,
	SIMPLEX_SMOOTH = FastNoiseLite.TYPE_SIMPLEX_SMOOTH
}

@export var current_terrain_type : TerrainNoiseType = TerrainNoiseType.CELLULAR:
	set(value):
		current_terrain_type = value
		if noise:
			noise.noise_type = current_terrain_type as int

#var island_data : Dictionary = {}

func _ready() -> void:
	
	if not noise:
		noise = FastNoiseLite.new()

	noise.noise_type = current_terrain_type as int
	
	await get_tree().process_frame
	_generate_island()
	
	IslandManager.island_data[self.get_instance_id()] = {"position":global_position,"size":island_size}

func _generate_island() -> void:
	if not noise: 
		noise = FastNoiseLite.new()
	noise.noise_type = current_terrain_type as int
	# 1. Setup Mesh Data
	noise.seed = island_seed
	var plane = PlaneMesh.new()
	plane.size = Vector2(island_size, island_size)
	plane.subdivide_width = int(subdivision.x)
	plane.subdivide_depth = int(subdivision.y)
	
	# Extract ALL data generated by the PlaneMesh (Vertices, UVs, etc.)
	var st = SurfaceTool.new()
	st.create_from(plane, 0)
	var mesh_data = st.commit_to_arrays()
	
	# Grab a reference to the vertex array so we can modify it
	var vertices = mesh_data[Mesh.ARRAY_VERTEX]
	
	# 2. Shape the terrain
	for i in range(vertices.size()):
		var pos = vertices[i]
		var dist = Vector2(pos.x, pos.z).length()
		var max_radius = island_size / 2.0
		
		# --- ORGANIC SHAPE WARPING ---
		var warp_scale = max_radius * 0.4 
		var warp_x = noise.get_noise_2d(pos.x + 1000.0, pos.z) * warp_scale
		var warp_z = noise.get_noise_2d(pos.x, pos.z + 1000.0) * warp_scale
		
		var distorted_dist = Vector2(pos.x + warp_x, pos.z + warp_z).length()
		var beach_radius = max_radius * 0.5
		
		# --- CONE EFFECT ---
		var dist_norm = clamp(dist / max_radius, 0.0, 1.0)
		var expansion_factor = lerp(1.0, 2.0, smoothstep(0.0, 1.0, dist_norm))
		pos.x *= expansion_factor
		pos.z *= expansion_factor
		
		# --- HEIGHT & FALLOFF ---
		var raw_noise = (noise.get_noise_2d(pos.x, pos.z) + 1.0) * 0.5
		
		if distorted_dist <= beach_radius:
			var island_norm = distorted_dist / beach_radius
			pos.y = (raw_noise * max_height) * (1.0 - island_norm)
		else:
			var underwater_dist = distorted_dist - beach_radius
			var dropoff_zone = max_radius - beach_radius
			var drop_progress = clamp(underwater_dist / dropoff_zone, 0.0, 1.0)
			var curve = pow(drop_progress, 1.5)
			pos.y = lerp(0.0, -1000.0, curve)
			
		vertices[i] = pos
		
	# Put the modified vertices back into the main mesh data array
	mesh_data[Mesh.ARRAY_VERTEX] = vertices
	
	# 3. Create the updated mesh while preserving UVs
	var array_mesh = ArrayMesh.new()
	array_mesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, mesh_data)
	
	# Recalculate lighting normals based on the new wobbly shape
	var final_st = SurfaceTool.new()
	final_st.create_from(array_mesh, 0)
	final_st.generate_normals()
	var new_mesh = final_st.commit()

	# 4. Apply to MeshInstance3D
	if not terrain_mesh_node:
		terrain_mesh_node = MeshInstance3D.new()
		terrain_mesh_node.name = "TerrainMesh"
		add_child(terrain_mesh_node)
		if Engine.is_editor_hint() and get_tree() and get_tree().edited_scene_root:
			terrain_mesh_node.owner = get_tree().edited_scene_root
	
	terrain_mesh_node.mesh = new_mesh
	
	# material_override is safer than set_surface_override_material for procedural meshes
	terrain_mesh_node.material_override = ISLAND_TERRAIN_SHADERS
	
	# 5. Create/Update Collision
	var static_body = terrain_mesh_node.get_node_or_null("StaticBody3D")
	if not static_body:
		static_body = StaticBody3D.new()
		static_body.name = "StaticBody3D"
		terrain_mesh_node.add_child(static_body)
		static_body.set_collision_layer_value(2, true)
		static_body.set_collision_layer_value(4, true)
		static_body.set_collision_mask_value(2, true)
		static_body.set_collision_mask_value(4, true)
		if Engine.is_editor_hint() and get_tree() and get_tree().edited_scene_root:
			static_body.owner = get_tree().edited_scene_root
	
	var collision_shape = static_body.get_node_or_null("CollisionShape3D")
	if not collision_shape:
		collision_shape = CollisionShape3D.new()
		collision_shape.name = "CollisionShape3D"
		static_body.add_child(collision_shape)
		if Engine.is_editor_hint() and get_tree() and get_tree().edited_scene_root:
			collision_shape.owner = get_tree().edited_scene_root
	
	collision_shape.shape = terrain_mesh_node.mesh.create_trimesh_shape()
	
	# 6. Scatter Foliage
	_scatter_foliage(vertices)

